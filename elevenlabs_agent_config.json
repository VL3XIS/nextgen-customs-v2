{
    "agent_name": "NextGen Shop Assistant",
    "system_prompt": "You are the AI engine for NextGen Customs. \n\n### CRITICAL CONTEXT\n- **CURRENT TIME**: {{current_time}}.\n- **USER**: {{user_name}} (Role: {{user_role}}).\n\n### TOOL USE PROTOCOL (CRITICAL)\n- **NEVER FAKE A BOOKING**. You CANNOT book by just sayin 'Synced'.\n- You **MUST** call the `book_appointment` tool to confirm.\n- **WAIT** for the tool to return 'success' (or 'error').\n\n### MODES\n1. **ADMIN**: Concise, professional. Use `list_active_jobs`.\n2. **CUSTOMER**: Warm, friendly. Use `check_availability` and `book_appointment`.\n",
    "tools": [
        {
            "type": "client",
            "name": "check_availability",
            "description": "Check available appointment slots for a specific date.",
            "parameters": {
                "type": "object",
                "properties": {
                    "date": {
                        "type": "string",
                        "description": "YYYY-MM-DD"
                    },
                    "appointment_type": {
                        "type": "string",
                        "enum": [
                            "drop_off",
                            "consultation",
                            "pickup"
                        ]
                    }
                },
                "required": [
                    "date"
                ]
            }
        },
        {
            "type": "client",
            "name": "book_appointment",
            "description": "Book an appointment. Requires Name, Phone, Date, Time.",
            "parameters": {
                "type": "object",
                "properties": {
                    "customer_name": {
                        "type": "string"
                    },
                    "customer_phone": {
                        "type": "string"
                    },
                    "customer_email": {
                        "type": "string"
                    },
                    "scheduled_date": {
                        "type": "string",
                        "description": "YYYY-MM-DD"
                    },
                    "scheduled_time": {
                        "type": "string",
                        "description": "HH:MM"
                    },
                    "description": {
                        "type": "string"
                    }
                },
                "required": [
                    "customer_name",
                    "scheduled_date",
                    "scheduled_time"
                ]
            }
        },
        {
            "type": "client",
            "name": "check_status",
            "description": "Check the status of a vehicle currently in the shop.",
            "parameters": {
                "type": "object",
                "properties": {
                    "vehicle": {
                        "type": "string",
                        "description": "Model or Make (e.g. 'Civic', 'F-150')"
                    },
                    "customerName": {
                        "type": "string",
                        "description": "Customer name to refine search"
                    }
                }
            }
        },
        {
            "type": "client",
            "name": "reschedule_appointment",
            "description": "Reschedule an existing appointment.",
            "parameters": {
                "type": "object",
                "properties": {
                    "appointment_id": {
                        "type": "string",
                        "description": "ID of the appointment to reschedule"
                    },
                    "new_date": {
                        "type": "string",
                        "description": "New date in YYYY-MM-DD"
                    },
                    "new_time": {
                        "type": "string",
                        "description": "New time in HH:MM"
                    }
                },
                "required": [
                    "appointment_id",
                    "new_date",
                    "new_time"
                ]
            }
        },
        {
            "type": "client",
            "name": "cancel_appointment",
            "description": "Cancel an appointment.",
            "parameters": {
                "type": "object",
                "properties": {
                    "appointment_id": {
                        "type": "string",
                        "description": "ID of the appointment to cancel"
                    },
                    "cancellation_reason": {
                        "type": "string",
                        "description": "Reason for cancellation"
                    }
                },
                "required": [
                    "appointment_id"
                ]
            }
        },
        {
            "type": "client",
            "name": "list_active_jobs",
            "description": "List all active jobs in the shop. Can filter by status.",
            "parameters": {
                "type": "object",
                "properties": {
                    "filter": {
                        "type": "string",
                        "description": "Filter by status: all, in_progress, waiting_parts, ready_pickup"
                    }
                }
            }
        },
        {
            "type": "client",
            "name": "analyze_revenue",
            "description": "Analyze revenue for a specific time period.",
            "parameters": {
                "type": "object",
                "properties": {
                    "time_period": {
                        "type": "string",
                        "description": "today, week, month, quarter, year"
                    }
                },
                "required": [
                    "time_period"
                ]
            }
        },
        {
            "type": "client",
            "name": "search_customer_history",
            "description": "Search for a customer's service history.",
            "parameters": {
                "type": "object",
                "properties": {
                    "customer_identifier": {
                        "type": "string",
                        "description": "Name or phone number"
                    }
                },
                "required": [
                    "customer_identifier"
                ]
            }
        },
        {
            "type": "client",
            "name": "generate_report",
            "description": "Generate a business report.",
            "parameters": {
                "type": "object",
                "properties": {
                    "report_type": {
                        "type": "string",
                        "description": "daily, financial, staff"
                    }
                },
                "required": [
                    "report_type"
                ]
            }
        }
    ]
}