            "parameters": {
                "type": "object",
                "properties": {
                    "date": {
                        "type": "string",
                        "description": "YYYY-MM-DD"
                    },
                    "appointment_type": {
                        "type": "string",
                        "enum": [
                            "drop_off",
                            "consultation",
                            "pickup"
                        ]
                    }
                },
                "required": [
                    "date"
                ]
            }
        },
        {
