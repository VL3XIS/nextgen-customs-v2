                        "type": "string"
                    },
                    "scheduled_date": {
                        "type": "string",
                        "description": "YYYY-MM-DD"
                    },
                    "scheduled_time": {
                        "type": "string",
                        "description": "HH:MM (24h or with AM/PM)"
                    },
                    "vehicle_model": {
