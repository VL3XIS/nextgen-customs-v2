generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  shopName     String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  analytics    Analytics[]
  jobs         Job[]
}

model Job {
  id           String    @id @default(uuid())
  userId       String
  vehicle      String
  customerName String    @default("Customer")
  customerEmail String?  // Added for notifications
  status       JobStatus @default(ESTIMATE)
  services     String
  notes        String?
  estimatedValue Float     @default(0)
  startedAt    DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos       Photo[]
  posts        Post[]
}

model Photo {
  id         String   @id @default(uuid())
  jobId      String
  url        String
  uploadedAt DateTime @default(now())
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Post {
  id          String    @id @default(uuid())
  jobId       String
  platform    String
  caption     String
  hashtags    String[]
  status      String    @default("draft")
  generatedAt DateTime  @default(now())
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Analytics {
  id               String   @id @default(uuid())
  userId           String
  date             DateTime @default(now())
  postsGenerated   Int      @default(0)
  timeSavedMinutes Int      @default(0)
  jobsCompleted    Int      @default(0)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum JobStatus {
  ESTIMATE
  APPROVED
  IN_PROGRESS
  PAINT
  QUALITY_CHECK
  COMPLETE
}
